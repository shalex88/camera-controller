@startuml Camera Service Class Diagram

skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontSize 10
skinparam packageFontSize 12

package camera_service {
  package common {
    interface ICameraOperations {
      + setZoom(zoom_level: types::zoom): Result<void>
      + getZoom(): Result<types::zoom>
      + setFocus(focus_value: types::focus): Result<void>
      + getFocus(): Result<types::focus>
    }
  }

  package api {
    class Controller {
      - request_handler_: std::shared_ptr<IRequestHandler>
      - transport_: std::unique_ptr<ITransport>
      - server_address_: std::string
      - running_: std::atomic<bool>
      - service_thread_: std::thread
      + Controller(std::shared_ptr<IRequestHandler>, std::unique_ptr<ITransport>, const std::string&)
      + startAsync(): Result<void>
      + stop(): Result<void>
      + isRunning(): bool
    }

    interface IRequestHandler {
      + start(): Result<void>
      + stop(): Result<void>
      + isRunning(): bool
    }

    class RequestHandler {
      - core_: std::unique_ptr<core::ICore>
      - running_: std::atomic<bool>
      + RequestHandler(std::unique_ptr<core::ICore>)
      + startAsync(): Result<void>
      + stop(): Result<void>
      + isRunning(): bool
      + setZoom(zoom_level: types::zoom): Result<void>
      + getZoom(): Result<types::zoom>
      + setFocus(focus_value: types::focus): Result<void>
      + getFocus(): Result<types::focus>
    }

    interface ITransport {
      + start(server_address: std::string): Result<void>
      + stop(): Result<void>
      + runLoop(): Result<void>
    }

    class GrpcTransport {
      - server_: std::unique_ptr<grpc::Server>
      - callback_handler_: std::unique_ptr<GrpcCallbackHandler>
      + GrpcTransport(request_handler: std::shared_ptr<IRequestHandler>)
      + start(server_address: std::string): Result<void>
      + stop(): Result<void>
      + runLoop(): Result<void>
    }

    class GrpcCallbackHandler {
      - request_handler_: std::shared_ptr<IRequestHandler>
      + GrpcCallbackHandler(std::shared_ptr<IRequestHandler>)
      + SetZoom(context: grpc::CallbackServerContext*, request: camera::SetZoomRequest*, response: camera::SetZoomResponse*): grpc::ServerUnaryReactor*
      + SetFocus(context: grpc::CallbackServerContext*, request: camera::SetFocusRequest*, response: camera::SetFocusResponse*): grpc::ServerUnaryReactor*
      + GetZoom(context: grpc::CallbackServerContext*, request: camera::GetZoomRequest*, response: camera::GetZoomResponse*): grpc::ServerUnaryReactor*
      + GetFocus(context: grpc::CallbackServerContext*, request: camera::GetFocusRequest*, response: camera::GetFocusResponse*): grpc::ServerUnaryReactor*
    }

    class ControllerFactory {
      + {static} createController(controller_type: std::string, server_address: std::string, core: std::unique_ptr<ICore>): std::unique_ptr<Controller>
    }
  }

  package core {
    interface ICore {
      + initialize(): Result<void>
      + shutdown(): Result<void>
    }

    class Core {
      - camera_: std::unique_ptr<data::ICamera>
      + Core(std::unique_ptr<data::ICamera>)
      + initialize(): Result<void>
      + shutdown(): Result<void>
      + setZoom(zoom_level: types::zoom): Result<void>
      + getZoom(): Result<types::zoom>
      + setFocus(focus_value: types::focus): Result<void>
      + getFocus(): Result<types::focus>
    }

    class CoreFactory {
      + {static} createCore(camera_type: std::string, std::unique_ptr<data::ICamera> camera): std::unique_ptr<ICore>
    }
  }

  package data {
    interface ICamera {
      + connect(): Result<void>
      + disconnect(): Result<void>
    }

    class Camera {
      - camera_impl_: std::unique_ptr<ICameraStrategy>
      - limits_: CameraLimits
      - connected_: bool
      + Camera(std::unique_ptr<ICameraStrategy>)
      + setZoom(zoom_level: types::zoom): Result<void>
      + getZoom(): Result<types::zoom>
      + setFocus(focus_value: types::focus): Result<void>
      + getFocus(): Result<types::focus>
      + connect(): Result<void>
      + disconnect(): Result<void>
      + isConnected(): bool
      - isValidZoom(value: types::zoom): bool
      - isValidFocus(value: types::focus): bool
    }

    interface ICameraStrategy {
      + connect(): Result<void>
      + disconnect(): Result<void>
      + getLimits(): CameraLimits
    }

    class NfovCamera {
      - limits_: CameraLimits
      + NfovCamera()
      + setZoom(zoom_level: types::zoom): Result<void>
      + getZoom(): Result<types::zoom>
      + setFocus(focus_value: types::focus): Result<void>
      + getFocus(): Result<types::focus>
      + connect(): Result<void>
      + disconnect(): Result<void>
      + getLimits(): CameraLimits
    }

