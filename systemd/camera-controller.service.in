[Unit]
Description=Camera Controller Service
Documentation=https://github.com/shalex88/camera-controller
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=@PROJECT_INSTALL_BINDIR@/@PROJECT_NAME@ -c @PROJECT_INSTALL_CONFIGDIR@/config-wfov.yaml
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=camera-controller

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# User and group (adjust as needed)
# User=camera
# Group=camera

[Install]
WantedBy=multi-user.target
